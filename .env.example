# Supabase â€” copy to .env.local and fill in from your Supabase project settings.
# Leave these blank to run the app in demo mode (simulated auth, no backend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (Vercel project env, never VITE_-prefixed) ---
# Stripe test-mode keys and the three recurring Price ids (Personal Plus, Team, Growth).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_GROWTH=
# Supabase service role key — lets the webhook write billing_subscriptions. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=
